  "mcp": [
    {
      "name": "chrome-devtools",
      "scope": "user",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "windowsWrapper": ["cmd", "/c"],
      "requiredArgs": [
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "forbiddenArgs": [
        "--autoConnect",
        "--auto-connect",
        "--browserUrl",
        "--browser-url",
        "-u",
        "--wsEndpoint",
        "--ws-endpoint",
        "-w"
      ],
      "requires": {
        "node": "20.19.0",
        "npx": true,
        "chrome": true
      }
    }
  ],
  "external": [
    {
      "name": "impeccable",
      "displayName": "Impeccable",
      "optional": true,
      "switch": "WithImpeccable",
      "source": "https://github.com/pbakaus/impeccable",
      "license": "Apache-2.0",
      "scope": "global",
      "supportedScopes": [
        "global",
        "project"
      ],
      "install": {
        "method": "npx",
        "package": "impeccable",
        "version": "latest",
        "versionStrategy": "npx resolve impeccable@latest a cada execucao; o instalador oficial baixa o pacote assinado mais recente da skill",
        "args": [
          "install",
          "-y",
          "--providers=claude",
          "--scope=global",
          "--no-hooks"
        ],
        "requiredArgs": [
          "--providers=claude",
          "--scope=global",
          "--no-hooks"
        ],
        "forbiddenArgs": [
          "--project",
          "--local",
          "--scope=project"
        ],
        "updateHint": "npx -y impeccable@latest update -y --scope=global --no-hooks"
      },
      "requires": {
        "node": "22.18.0",
        "npx": true,
        "network": true
      },
      "detect": {
        "root": "claude-home",
        "requiredFiles": [
          "skills/impeccable/SKILL.md",
          "skills/impeccable/scripts/impeccable",
          "skills/impeccable/scripts/impeccable.cmd"
        ],
        "requiredGlobs": [
          {
            "pattern": "agents/impeccable-*.md",
            "min": 1
          }
        ],
        "versionFile": "skills/impeccable/SKILL.md"
      },
      "notes": [
        "Grava em ~/.claude/skills/impeccable e ~/.claude/agents (agents impeccable-*).",
        "Sem hooks (--no-hooks): os hooks serao opcionais por projeto.",
        "No primeiro uso, a skill baixa o motor do Impeccable para dentro da propria pasta ou ~/.impeccable/bin."
      ]
    }
  ],
  "projectIntegrations": [
    {
      "name": "shadcn-mcp",
      "displayName": "shadcn MCP",
      "optional": true,
      "switch": "WithShadcn",
      "projectOnly": true,
      "scope": "project",
      "source": "https://github.com/shadcn-ui/ui",
      "docs": "https://ui.shadcn.com/docs/mcp",
      "license": "MIT",
      "install": {
        "method": "npx",
        "package": "shadcn",
        "version": "latest",
        "versionStrategy": "npx resolve shadcn@latest a cada execucao; a entrada gravada tambem usa shadcn@latest (padrao do CLI oficial)",
        "args": [
          "mcp",
          "init",
          "--client",
          "claude"
        ],
        "requiredArgs": [
          "mcp",
          "init",
          "--client",
          "claude"
        ],
        "forbiddenArgs": []
      },
      "requires": {
        "node": "20.18.1",
        "npx": true,
        "network": true
      },
      "requiresFiles": [
        "package.json"
      ],
      "detect": {
        "file": "components.json",
        "schemaHint": "ui.shadcn.com"
      },
      "config": {
        "file": ".mcp.json",
        "serversKey": "mcpServers",
        "entry": "shadcn",
        "expected": {
          "command": "npx",
          "args": [
            "shadcn@latest",
            "mcp"
          ]
        }
      },
      "backupFiles": [
        "package.json",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "bun.lock",
        "bun.lockb"
      ],
      "initHint": "npx shadcn@latest init",
      "notes": [
        "O comando oficial grava a entrada 'shadcn' em .mcp.json (mesclando com o que ja existe).",
        "Ele tambem instala shadcn@latest como devDependency (altera package.json, lockfile e node_modules).",
        "Nada e configurado globalmente; o Chrome DevTools MCP e outros servidores nao sao tocados."
      ],
      "futureSkill": {
        "name": "shadcn",
        "source": "https://github.com/shadcn-ui/ui/tree/main/skills/shadcn",
        "install": "npx skills add shadcn/ui",
        "status": "nao instalada; registrada como possibilidade futura"
      }
    }
  ]
}