{
  "schemaVersion": 1,
  "skills": [
    {
      "name": "ui-ux-pro-max",
      "path": "skills/ui-ux-pro-max",
      "requires": ["python"],
      "smokeTest": {
        "type": "python",
        "script": "scripts/search.py",
        "args": ["saas dashboard", "--domain", "style", "-n", "1"],
        "expectOutput": "Result 1"
      }
    },
    { "name": "frontend-design", "path": "skills/frontend-design" },
    { "name": "web-design-guidelines", "path": "skills/web-design-guidelines" },
    { "name": "animate", "path": "skills/animate" },
    { "name": "review-animations", "path": "skills/review-animations" },
    { "name": "improve-animations", "path": "skills/improve-animations" },
    { "name": "find-animation-opportunities", "path": "skills/find-animation-opportunities" },
    { "name": "animation-vocabulary", "path": "skills/animation-vocabulary" },
    { "name": "emil-design-eng", "path": "skills/emil-design-eng" }
  ],
  "mcp": [
    {
      "name": "chrome-devtools",
      "scope": "user",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "windowsWrapper": ["cmd", "/c"],
      "requiredArgs": ["--isolated", "--no-usage-statistics", "--no-performance-crux"],
      "forbiddenArgs": ["--autoConnect", "--auto-connect", "--browserUrl", "--browser-url", "-u", "--wsEndpoint", "--ws-endpoint", "-w"],
      "requires": { "node": "20.19.0", "npx": true, "chrome": true }
    }
  ],
  "external": [
    {
      "name": "impeccable",
      "displayName": "Impeccable",
      "optional": true,
      "switch": "WithImpeccable",
      "source": "https://github.com/pbakaus/impeccable",
      "license": "Apache-2.0",
      "scope": "global",
      "supportedScopes": ["global", "project"],
      "install": {
        "method": "npx",
        "package": "impeccable",
        "version": "latest",
        "versionStrategy": "npx resolve impeccable@latest a cada execucao; o instalador oficial baixa o pacote assinado mais recente da skill",
        "args": ["install", "-y", "--providers=claude", "--scope=global", "--no-hooks"],
        "requiredArgs": ["--providers=claude", "--scope=global", "--no-hooks"],
        "forbiddenArgs": ["--project", "--local", "--scope=project"],
        "updateHint": "npx -y impeccable@latest update -y --scope=global --no-hooks"
      },
      "requires": { "node": "22.18.0", "npx": true, "network": true },
      "detect": {
        "root": "claude-home",
        "requiredFiles": [
          "skills/impeccable/SKILL.md",
          "skills/impeccable/scripts/impeccable",
          "skills/impeccable/scripts/impeccable.cmd"
        ],
        "requiredGlobs": [
          { "pattern": "agents/impeccable-*.md", "min": 1 }
        ],
        "versionFile": "skills/impeccable/SKILL.md"
      },
      "notes": [
        "Grava em ~/.claude/skills/impeccable e ~/.claude/agents (agents impeccable-*).",
        "Sem hooks (--no-hooks): os hooks serao opcionais por projeto.",
        "No primeiro uso, a skill baixa o motor do Impeccable para dentro da propria pasta ou ~/.impeccable/bin."
      ]
    }
  ]
}
